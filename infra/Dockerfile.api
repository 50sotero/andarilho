# syntax=docker/dockerfile:1.7
# FastAPI control plane. No CUDA/PyTorch here (README section 3).
FROM python:3.13-slim-bookworm AS base
COPY --from=ghcr.io/astral-sh/uv:0.11.30 /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH="/opt/venv/bin:$PATH" PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /app/services/api

COPY services/api/pyproject.toml services/api/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY services/api/ ./
RUN uv sync --frozen --no-dev

# Documented script paths (README section 14) and the synthetic fixture they seed.
COPY scripts/ /app/scripts/
COPY infra/storage-cors.json /app/infra/storage-cors.json
COPY packages/scene-contract/ /app/packages/scene-contract/

RUN useradd --system --uid 10001 --home /app andarilho
USER andarilho
EXPOSE 8000
CMD ["uvicorn", "andarilho_api.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers"]

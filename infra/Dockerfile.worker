# syntax=docker/dockerfile:1.7
# CPU worker: validation, FFprobe/FFmpeg preparation, normalization, geometry,
# packaging and scene validation. It never imports the API package.
FROM python:3.13-slim-bookworm
ARG SPLAT_TRANSFORM_VERSION=1.4.0
COPY --from=ghcr.io/astral-sh/uv:0.11.30 /uv /usr/local/bin/uv
# splat-transform (the same pinned version as the GPU image) compresses the render
# asset to SOG during normalizing, which runs here; npm is only needed to install it.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg nodejs npm \
 && npm install -g "@playcanvas/splat-transform@${SPLAT_TRANSFORM_VERSION}" \
 && npm cache clean --force \
 && apt-get purge -y npm && apt-get autoremove -y \
 && rm -rf /var/lib/apt/lists/*
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH="/opt/venv/bin:$PATH" PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /app/services/worker

COPY services/worker/pyproject.toml services/worker/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY services/worker/ ./
RUN uv sync --frozen --no-dev \
 && python -m andarilho_worker.toolcheck --only splat-transform ffmpeg

RUN useradd --system --uid 10001 --home /app andarilho \
 && mkdir -p /scratch && chown andarilho /scratch
USER andarilho
ENV WORKER_CAPABILITY=cpu WORKER_SCRATCH_DIR=/scratch
CMD ["python", "-m", "andarilho_worker"]

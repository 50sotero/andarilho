# Names and safe example values only. Never commit real credentials.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=example-publishable-key
API_INTERNAL_URL=http://api:8000
DATABASE_URL=postgresql+psycopg://andarilho:local-password@postgres:5432/andarilho
AUTH_ISSUER=https://example.supabase.co/auth/v1
AUTH_AUDIENCE=authenticated
AUTH_JWKS_URL=https://example.supabase.co/auth/v1/.well-known/jwks.json
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=andarilho-local
S3_ACCESS_KEY_ID=local-development-only
S3_SECRET_ACCESS_KEY=local-development-only
WORKER_CAPABILITY=cpu
WORKER_MAX_CONCURRENCY=1
WORKER_SCRATCH_DIR=/scratch
# Per project; any single file is also capped at 5 GiB (the API's one-copy freeze).
UPLOAD_MAX_TOTAL_BYTES=2147483648
# Days after which the bucket's abort-incomplete-multipart rule ends an unfinished
# upload. A part upload has no time limit of its own, so the worker keeps an aborted
# upload's ID, checking it for late parts, until that rule has run. Keep it equal to the
# production bucket's rule; bootstrap-storage applies it locally.
MULTIPART_ABORT_DAYS=2
RUN_MAX_SECONDS=3600
DELIVERY_URL_TTL_SECONDS=300
# development | test | production. Production rejects the example/local values above.
APP_ENV=development
# Optional AI advice for failed runs (README section 16); empty AI_PROVIDER = off.
AI_PROVIDER=
# OpenCode Go (the subscription). Pay-as-you-go balance: .../inference/openai/v1.
AI_BASE_URL=https://opencode.ai/inference/go/v1
AI_MODEL=deepseek-v4.1-flash
# Outside Compose: the path of a file holding the key (or set OPENCODE_API_KEY via a
# secret manager). Compose mounts OPENCODE_API_KEY_HOST_FILE read-only instead.
# Never put the key itself in any committed or shared file.
OPENCODE_API_KEY_FILE=
OPENCODE_API_KEY_HOST_FILE=
AI_MAX_OUTPUT_TOKENS=2048
AI_TIMEOUT_SECONDS=60
AI_MAX_CONCURRENCY=2
# Worker scene analysis (the scene_analysis stage), off by default. When AI_SCENE_ANALYSIS
# is true, the worker sends downscaled keyframes, the registered photos and the floor plan
# of each capture to the AI model above, to recognise rooms, doors and furniture. The key
# is the same OPENCODE_API_KEY_FILE / OPENCODE_API_KEY_HOST_FILE.
AI_SCENE_ANALYSIS=false
# One call carries a dozen images and answers with every object's parts, so the scene
# analysis has its own timeout and reply budget; AI_TIMEOUT_SECONDS and
# AI_MAX_OUTPUT_TOKENS above are the API's and do not apply to it.
AI_SCENE_TIMEOUT_SECONDS=180
AI_SCENE_MAX_OUTPUT_TOKENS=8192
# The web app shows a privacy notice on the capture page when true. Compose builds it from
# AI_SCENE_ANALYSIS; outside Compose, keep the two equal.
NEXT_PUBLIC_AI_SCENE_ANALYSIS=false
